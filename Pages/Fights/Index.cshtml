@page
@model UfcStatsWeb.Pages.Fights.IndexModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Fights";
    ViewData["BodyClass"] = "fights-index";
    var fights = Model.Fights?.ToList() ?? new List<UfcStatsWeb.Models.FightRecord>();
}

<div class="container">

    <form method="get" class="mb-3" onsubmit="return false;">
        <div class="input-group input-group-sm">
            <input name="q" id="searchBox" value="@Model.q" class="form-control form-control-sm" placeholder="Search fighter, event or location…" aria-label="Search" />
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Fights/Index">Reset</a>
        </div>
    </form>

    <div class="table-wrap card shadow-sm p-3 table-card" role="region" aria-label="Fights table">
        <table id="fightsTable" class="table table-sm table-hover ufc-table mb-0">
            <thead>
                <tr>
                    <th class="sortable" data-type="date">Date<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Event<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Location<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Red<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Blue<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Result<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Method<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="number">Rnd<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="text">Time<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="number">R KD<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="number">B KD<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="number">R SS<span class="sort-indicator"></span></th>
                    <th class="sortable" data-type="number">B SS<span class="sort-indicator"></span></th>
                    <th class="col-details">Details</th>
                </tr>
            </thead>

            <tbody>

                @functions {
                    string NormalizeName(string s)
                    {
                        if (string.IsNullOrWhiteSpace(s)) return s;
                        return System.Globalization.CultureInfo.InvariantCulture.TextInfo
                        .ToTitleCase(s.ToLowerInvariant());
                    }
                }


                @foreach (var r in fights)
                {
                    var search = string.Join(" ",
                    new[] { r.RedFighterName, r.BlueFighterName, r.EventName, r.EventLocation,
                                r.RedFighterNickname, r.BlueFighterNickname })
                    .ToLowerInvariant();

                    <tr data-search="@search">
                        <td class="nowrap muted"
                            data-sort-value="@((r.EventDate?.ToString("yyyy-MM-dd") ?? ""))">
                            <span class="cell-truncate">@((r.EventDate?.ToString("dd/MM/yy") ?? ""))</span>
                        </td>

                        <td data-sort-value="@r.EventName" class="muted">
                            <span class="cell-truncate">@r.EventName</span>
                        </td>

                        <td data-sort-value="@r.EventLocation" class="muted">
                            <span class="cell-truncate">@r.EventLocation</span>
                        </td>

                        <td>
                            <span class="cell-truncate">
                                @NormalizeName(r.RedFighterName)
                                @if (!string.IsNullOrWhiteSpace(r.RedFighterNickname))
                                {
                                    <small class="text-muted ms-1">(@NormalizeName(r.RedFighterNickname))</small>
                                }
                            </span>
                        </td>

                        <td>
                            <span class="cell-truncate">
                                @NormalizeName(r.BlueFighterName)
                                @if (!string.IsNullOrWhiteSpace(r.BlueFighterNickname))
                                {
                                    <small class="text-muted ms-1">(@NormalizeName(r.BlueFighterNickname))</small>
                                }
                            </span>
                        </td>

                        <td data-sort-value="@($"{r.RedFighterResult}/{r.BlueFighterResult}")">
                            <span class="cell-truncate">@r.RedFighterResult / @r.BlueFighterResult</span>
                        </td>

                        <td data-sort-value="@r.Method">
                            <span class="cell-truncate">@r.Method</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.Round">
                            <span class="cell-truncate">@r.Round</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.Time">
                            <span class="cell-truncate">@r.Time</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.RedFighterKD">
                            <span class="cell-truncate">@r.RedFighterKD</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.BlueFighterKD">
                            <span class="cell-truncate">@r.BlueFighterKD</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.RedFighterSigStr">
                            <span class="cell-truncate">@r.RedFighterSigStr</span>
                        </td>

                        <td class="nowrap" data-sort-value="@r.BlueFighterSigStr">
                            <span class="cell-truncate">@r.BlueFighterSigStr</span>
                        </td>

                        <td>
                            <details>
                                <summary>Show</summary>
                                <pre class="table-json">
    @System.Text.Json.JsonSerializer.Serialize(
        r,
        new System.Text.Json.JsonSerializerOptions { WriteIndented = true }
)
                            </pre>
                        </details>
                    </td>
                </tr>
                                }
            </tbody>
        </table>
    </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        const searchBox = document.getElementById('searchBox');
        const rows = Array.from(document.querySelectorAll('#fightsTable tbody tr'));

        function norm(s) { return (s || '').toLowerCase(); }

        function applyFilters() {
            const q = norm(searchBox.value);
            rows.forEach(r => {
                const txt = r.getAttribute('data-search') || '';
                r.style.display = q === '' || txt.includes(q) ? '' : 'none';
            });
        }

        searchBox.addEventListener('input', applyFilters);
    })();
</script>
}