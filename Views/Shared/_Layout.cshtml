<!DOCTYPE html>
<html lang="en">
<head>
 <meta charset="utf-8" />
 <meta name="viewport" content="width=device-width, initial-scale=1.0" />
 <title>@ViewData["Title"] - UFC Stats</title>
 <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
 <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="@ViewData["BodyClass"]">
 <header>
 <nav class="navbar navbar-expand-lg navbar-light bg-white site-navbar">
 <div class="container-xxl">
 <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
 <img src="/images/logo.png" alt="UFC Stats" class="site-logo" onerror="this.style.display='none'" />
 </a>
 <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
 <span class="navbar-toggler-icon"></span>
 </button>
 <div class="collapse navbar-collapse" id="mainNav">
 <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
 <li class="nav-item">
 <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
 </li>
 <li class="nav-item">
 <a class="nav-link" asp-page="/Fights/Index">Fights</a>
 </li>
 <li class="nav-item">
 <a class="nav-link" asp-page="/Rankings/Index">Rankings</a>
 </li>
 </ul>
 </div>
 </div>
 </nav>
 </header>

 <main class="py-4">
 <div class="container-xxl">
 @RenderBody()
 </div>
 </main>

 <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
 <script src="/js/site.js"></script>
 @RenderSection("Scripts", required: false)
</body>
</html>
